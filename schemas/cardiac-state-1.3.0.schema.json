            "electrical",
            "mechanical",
            "imaging",
            "safety",
            "structural",
            "clinical",
            "other"
          ]
        },
        "values": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "status": {
          "type": "string",
          "enum": [
            "observed",
            "inferred",
            "simulated"
          ]
        },
        "uncertainty": {
          "type": "object"
        },
        "recorded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
