      "items": {
        "$ref": "#/$defs/simulationArtifact"
      }
    },
    "prediction_artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predictionArtifact"
      }
    },
    "evaluation_artifacts": {
      "type": "array",
