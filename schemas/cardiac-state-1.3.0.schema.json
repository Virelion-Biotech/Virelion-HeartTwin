          "anyOf": [
            {
              "$ref": "#/$defs/uncertainty"
            },
            {
              "type": "null"
            }
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
