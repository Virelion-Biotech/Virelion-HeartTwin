      "const": "1.3.0"
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    },
    "state_fingerprint": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "biological_context": {
      "type": "object"
    },
    "state_phase": {
      "$ref": "#/$defs/statePhase"
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "atlas_context": {
      "anyOf": [
        {
          "$ref": "#/$defs/atlas"
