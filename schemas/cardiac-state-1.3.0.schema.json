    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provenance"
      }
    },
    "inferred_state": {
      "type": "object"
    },
    "simulations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "validation": {
